{
  "name": "rgl-protocol-experimental",
  "version": "1.0.0",
  "private": true,
  "description": "RGL Protocol \u2014 experimental Decentraland scenes deployed to rglprotocol.dcl.eth",
  "workspaces": [
    "scenes/physics",
    "scenes/avatar-attach-points",
    "scenes/ui-borders"
  ],
  "scripts": {
    "start": "sdk-commands start --multi-scene",
    "build": "npm run build --workspaces",
    "deploy": "node scripts/deploy-all.mjs",
    "upgrade-sdk:protocol-squad": "npm install --save-dev @dcl/sdk@protocol-squad && npm install --save-dev @dcl/sdk@protocol-squad --workspaces"
  },
  "devDependencies": {
    "@dcl/sdk": "next"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}
