{
  "name": "rgl-protocol-experimental",
  "version": "1.0.0",
  "private": true,
  "description": "RGL Protocol — experimental Decentraland scenes deployed to rglprotocol.dcl.eth",
  "workspaces": [
    "scenes/lobby",
    "scenes/scrollable-ui"
  ],
  "scripts": {
    "start": "sdk-commands start --multi-scene",
    "build": "npm run build --workspaces",
    "deploy": "sdk-commands deploy --target-content https://worlds-content-server.decentraland.org --multi-scene",
    "generate-code-images": "node scripts/generate-code-images.mjs",
    "upgrade-sdk:protocol-squad": "npm install --save-dev @dcl/sdk@protocol-squad && npm install --save-dev @dcl/sdk@protocol-squad --workspaces"
  },
  "devDependencies": {
    "@dcl/sdk": "7.22.6-25007982108.commit-83012ab",
    "carbon-now-cli": "^2.1.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}
